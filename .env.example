# Conexión a Neon PostgreSQL
# Copia este archivo como ".env" y rellena con tus credenciales reales.
#   cp .env.example .env
# El archivo .env está en .gitignore: nunca lo subas a GitHub.

# Formato: postgresql+psycopg2://USUARIO:CONTRASENA@HOST/neondb?sslmode=require
# La contraseña se enciende en Neon -> Dashboard -> tu proyecto -> Connection Details
NEON_DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@ep-TU-PROYECTO-pooler.REGION.aws.neon.tech/neondb?sslmode=require
